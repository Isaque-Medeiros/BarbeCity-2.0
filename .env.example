# ─────────────────────────────────────────────
# SERVIDOR
# ─────────────────────────────────────────────
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
TRUST_PROXY=0

# ─────────────────────────────────────────────
# BANCO DE DADOS (Neon PostgreSQL)
# ─────────────────────────────────────────────
DATABASE_URL=postgresql://USUARIO:SENHA@HOST/neondb?sslmode=require

# ─────────────────────────────────────────────
# SESSÃO / COOKIES
# ─────────────────────────────────────────────
SESSION_SECRET=troque-por-uma-string-aleatoria-bem-grande
SESSION_DAYS=30
COOKIE_SECURE=false

# ─────────────────────────────────────────────
# BREVO (e-mail transacional / magic link)
# ─────────────────────────────────────────────
BREVO_API_KEY=
BREVO_SENDER_EMAIL=contato@seudominio.com
BREVO_SENDER_NAME=Barbe City Jaraguá

# ─────────────────────────────────────────────
# GOOGLE OAUTH (preencher depois de subir o site)
# ─────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ─────────────────────────────────────────────
# PAGAMENTO PIX — MERCADO PAGO
# ─────────────────────────────────────────────
PIX_GATEWAY=mercadopago
PIX_ACCESS_TOKEN=
PIX_PUBLIC_KEY=
PIX_WEBHOOK_SECRET=

# ─────────────────────────────────────────────
# WHATSAPP
# WHATSAPP_NUMBER = número do dono (com DDI+DDD, só dígitos)
# WHATSAPP_TOKEN / WHATSAPP_PHONE_NUMBER_ID = WhatsApp Cloud API (opcional)
# Sem o token, o sistema gera um link wa.me pronto para envio manual.
# ─────────────────────────────────────────────
WHATSAPP_NUMBER=5511915040871
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─────────────────────────────────────────────
# GEMINI · EDITOR DE TEMA POR IA (opcional)
# Várias chaves separadas por vírgula. A cota do Gemini é por PROJETO,
# não por chave: para a rotação aumentar o limite, use chaves de
# projetos/contas diferentes. Sem chave, o editor fica desabilitado.
# ─────────────────────────────────────────────
GEMINI_API_KEYS=
GEMINI_MODELOS=gemini-2.5-flash,gemini-2.5-flash-lite
GEMINI_TIMEOUT_MS=40000
GEMINI_MAX_KEYS_PER_REQUEST=3
GEMINI_COOLDOWN_MIN=5
GEMINI_MAX_TOKENS=4096

# ─────────────────────────────────────────────
# ADMINISTRADOR INICIAL (criado pelo npm run db:seed)
# ─────────────────────────────────────────────
ADMIN_NOME=Anderson
ADMIN_EMAIL=admin@seudominio.com
ADMIN_SENHA=troque-esta-senha
OWNER_EMAIL=admin@seudominio.com

# ─────────────────────────────────────────────
# AGENDA
# ─────────────────────────────────────────────
APP_TIMEZONE=America/Sao_Paulo
BOOKING_SLOT_MINUTES=15
BOOKING_MAX_DIAS=60

# ─────────────────────────────────────────────
# DADOS DA BARBEARIA (fallback da tabela configuracoes)
# ─────────────────────────────────────────────
BARBEARIA_NOME=Barbe City Jaraguá
BARBEARIA_TELEFONE=(11) 91504-0871
BARBEARIA_ENDERECO=R. Jairo de Almeida Machado, 220 - Jaraguá, São Paulo - SP
