{
  "name": "barbe-city-jaragua",
  "version": "2.0.0",
  "private": true,
  "description": "Sistema de agendamento da Barbe City Jaraguá — versão remasterizada com banco de dados, pagamentos e painel administrativo.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --watch server/index.js",
    "start": "node server/index.js",
    "db:migrate": "node server/db/migrate.js",
    "db:seed": "node server/db/seed.js",
    "db:import": "node server/db/import-legado.js",
    "db:admin": "node server/scripts/criar-admin.js",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run db:import",
    "db:status": "node server/scripts/db-status.js",
    "smoke": "node server/scripts/smoke.js",
    "test": "node --test"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.1.0",
    "ws": "^8.22.0"
  }
}
